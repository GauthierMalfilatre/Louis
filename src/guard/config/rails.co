# Flows of the rails of Louis (Colang 1.0). The built-in ones (mask sensitive data on output...) come with NeMo:
# only the ones calling actions.py are defined here, and enabled in config.yml

# What Louis says when a rail refuses a message (replaces the English default of NeMo)
define bot refuse to respond
  "Je ne peux pas répondre à cette demande."

# The model could not read the message (Ollama stopped, the model missing): a message is never let through unchecked
define bot refuse unchecked
  "Je ne peux pas répondre : le garde-fou n'a pas pu vérifier ce message (le modèle ne répond pas, voir louis.log)."

# Refuse what breaks a policy of prompts.yml: the model reads the message against it (one request, guard/policy.py).
# They replace the self check input / output of NeMo, which asked Ollama in a way that made it reload the model
define subflow check input policy
  $verdict = execute check_policy(task="self_check_input", text=$user_message)
  if $verdict == "error"
    bot refuse unchecked
    stop
  if $verdict != "allowed"
    bot refuse to respond
    stop

define subflow check output policy
  $verdict = execute check_policy(task="self_check_output", text=$bot_message)
  if $verdict == "error"
    bot refuse unchecked
    stop
  if $verdict != "allowed"
    bot refuse to respond
    stop

# Anonymize: the message goes on, rewritten by the action
define subflow mask french ids on input
  $user_message = execute mask_french_ids(text=$user_message)

define subflow mask french ids on output
  $bot_message = execute mask_french_ids(text=$bot_message)

# Refuse: the action only tells, the flow stops the message
define subflow block secrets on output
  $found = execute contains_secret(text=$bot_message)
  if $found
    bot refuse to respond
    stop

# Refuse a call: the model reads the refusal as the result of the tool, and does without it.
# It starts with "Refusé" as the refusals of the tools do: Louis shows it as a refused call
define bot refuse tool call
  "Refusé : le garde-fou a bloqué cet appel, ses arguments contiennent une donnée sensible (secret ou donnée personnelle) qui sortirait de la machine. Refais-le sans elle."

define subflow block sensitive data in tool calls
  $leaks = execute tool_call_leaks(calls=$tool_calls)
  if $leaks
    bot refuse tool call
    stop

# The result of a tool that reads what nobody here wrote (the knowledge base) is data, never orders. Neither flow
# refuses the whole result: one poisoned passage must not cost the model the others. What the model reads is the
# tool message as the actions rewrite it (Guard.check_tool_result reads it back)
define subflow drop injected passages in tool results
  $tool_message = execute drop_injected(text=$tool_message)

define subflow mask sensitive data in tool results
  $tool_message = execute mask_sensitive(text=$tool_message)
